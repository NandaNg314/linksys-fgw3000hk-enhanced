#!/bin/sh
printf "Content-Type: application/json\r\n\r\n"
ACTION=$(echo "$QUERY_STRING" | sed -n 's/.*action=\([^&]*\).*/\1/p')
[ -z "$ACTION" ] && ACTION="status"

start_daemon() {
    if ! pgrep -f '^/data/ims_sip$' >/dev/null 2>&1; then
        nohup /data/ims_sip >/dev/null 2>&1 9>&- &
        sleep 1
    fi
}

stop_daemon() {
    PIDS=$(pgrep -f '^/data/ims_sip$' 2>/dev/null)
    if [ -n "$PIDS" ]; then
        kill $PIDS 2>/dev/null
        for i in 1 2 3 4 5 6; do
            pgrep -f '^/data/ims_sip$' >/dev/null 2>&1 || break
            usleep 500000 2>/dev/null || sleep 1
        done
        PIDS=$(pgrep -f '^/data/ims_sip$' 2>/dev/null)
        [ -n "$PIDS" ] && kill -9 $PIDS 2>/dev/null
    fi
}

if [ "$ACTION" = "ensure" ] || [ "$ACTION" = "restart" ] || [ "$ACTION" = "stop" ]; then
    exec 9>/tmp/.ims_sip_ctl.lock
    flock -x 9
    case "$ACTION" in
        ensure)
            start_daemon
            ;;
        restart)
            stop_daemon
            start_daemon
            ;;
        stop)
            stop_daemon
            ;;
    esac
    flock -u 9 2>/dev/null
    exec 9>&-
fi

PID=$(pgrep -f '^/data/ims_sip$' | head -n 1)
RUNNING="false"
[ -n "$PID" ] && RUNNING="true"
[ -z "$PID" ] && PID=0
ST=""
[ -f /tmp/ims_sip.status ] && ST=$(tail -n 1 /tmp/ims_sip.status | tr -d '\r\n' | sed 's/\\/\\\\/g; s/"/\\"/g')
printf '{"ok":true,"running":%s,"pid":%s,"status":"%s"}\n' "$RUNNING" "$PID" "$ST"
